# Copy to .env and fill in. Never commit the real .env.

# --- REQUIRED: sign JWTs. Generate with: openssl rand -hex 32 ---
SECRET_KEY=replace-me-with-openssl-rand-hex-32

# --- Google Gemini ---
# Create a key at https://aistudio.google.com/apikey
# Optional here: if unset, the google-genai SDK falls back to the
# GEMINI_API_KEY (then GOOGLE_API_KEY) environment variable.
GEMINI_API_KEY=
INGESTION_MODEL=gemini-3.6-flash

# --- Database ---
DATABASE_URL=sqlite:///./synapse.db

# --- Ingestion tuning ---
MAX_CHUNKS_PER_BOOK=8      # chapters sampled per upload (cost/latency cap)
LLM_CONCURRENCY=4          # parallel Gemini requests
MAX_UPLOAD_BYTES=33554432  # 32 MB
# Gemini thinking models reason before answering, and those tokens are billed
# against MAX_OUTPUT_TOKENS. 0 disables thinking (fastest/cheapest); raise it
# if cards come back shallow.
THINKING_BUDGET=2048

# --- Product rules ---
FREEMIUM_DAILY_CAP=5
ACCESS_TOKEN_EXPIRE_MINUTES=10080
